# Leave everything blank to run against the local Firebase Emulator Suite (npm run dev).
# Fill these in from Firebase console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# reCAPTCHA v3 site key registered for Firebase App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Set to "true" to print an App Check debug token in the browser console (local testing against a real project).
NEXT_PUBLIC_APPCHECK_DEBUG=

# Force emulator mode even when the variables above are set.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
